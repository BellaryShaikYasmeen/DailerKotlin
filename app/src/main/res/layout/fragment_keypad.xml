<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left: Keypad -->
    <GridLayout
        android:id="@+id/gridKeypad"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="true">

        <!-- Each button styled via keypad_button_bg.xml -->
        <Button
            android:id="@+id/btn1"
            style="@style/StyledKeypadButton"
            android:text="@string/_1" />

        <Button
            android:id="@+id/btn2"
            style="@style/StyledKeypadButton"
            android:text="@string/_2_nabc" />

        <Button
            android:id="@+id/btn3"
            style="@style/StyledKeypadButton"
            android:text="@string/_3_ndef" />

        <Button
            android:id="@+id/btn4"
            style="@style/StyledKeypadButton"
            android:text="@string/_4_nghi" />

        <Button
            android:id="@+id/btn5"
            style="@style/StyledKeypadButton"
            android:text="@string/_5_njkl" />

        <Button
            android:id="@+id/btn6"
            style="@style/StyledKeypadButton"
            android:text="@string/_6_nmno" />

        <Button
            android:id="@+id/btn7"
            style="@style/StyledKeypadButton"
            android:text="@string/_7_npqrs" />

        <Button
            android:id="@+id/btn8"
            style="@style/StyledKeypadButton"
            android:text="@string/_8_ntuv" />

        <Button
            android:id="@+id/btn9"
            style="@style/StyledKeypadButton"
            android:text="@string/_9_nwxyz" />

        <Button
            android:id="@+id/btnStar"
            style="@style/StyledKeypadButton"
            android:text="@string/star" />

        <Button
            android:id="@+id/btn0"
            style="@style/StyledKeypadButton"
            android:text="@string/_0_n" />

        <Button
            android:id="@+id/btnHash"
            style="@style/StyledKeypadButton"
            android:text="@string/_hash" />
    </GridLayout>

    <!-- Right: Dial panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:backgroundTint="#7C003CFF"
        android:backgroundTintMode="screen"
        android:gravity="center"
        android:orientation="vertical"

        android:paddingStart="12dp">

        <!-- Phone number and delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLength="10"
                android:maxLines="1"
                android:text=""
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:src="@drawable/outline_backspace_24"
                app:tint="#ffffff" />
        </LinearLayout>

        <!-- Dial Button -->
        <Button
            android:id="@+id/btnDial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/dial_button_bg"
            android:backgroundTint="#7C003CFF"
            android:enabled="false"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="18dp"
            android:text="@string/dial_ncall_from_android"
            android:textAlignment="center"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
