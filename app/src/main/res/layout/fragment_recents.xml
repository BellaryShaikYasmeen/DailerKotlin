<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Side Filter Panel -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/light_gray"
            android:padding="8dp">

            <Button
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:text="All Calls"
                android:background="@drawable/filter_selected"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/filterIncoming"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:text="Incoming"
                android:background="@drawable/filter_button"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/filterOutgoing"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:text="Outgoing"
                android:background="@drawable/filter_button"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/filterMissed"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:text="Missed"
                android:background="@drawable/filter_button"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- RecyclerView for Call List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentsRecyclerView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>
