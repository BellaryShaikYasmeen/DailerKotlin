<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.DailerKotlin.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary surfaces -->
        <item name="colorPrimary">#FFFFFF</item> <!-- Main background -->
        <item name="colorPrimaryVariant">#F5F5F5</item> <!-- Slight card/section background -->
        <item name="colorOnPrimary">#000000</item> <!-- Text on backgrounds -->

        <!-- Accent color (teal/cyan) -->
        <item name="colorAccent">#03DAC5</item>
        <item name="colorSecondary">#03DAC5</item>
        <item name="colorOnSecondary">#2196F3</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">#D0CBCB</item>
        <item name="android:colorBackground">#FFFFFF</item>

        <!-- Text colors -->
        <item name="android:textColor">#000000</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#666666</item>
        <item name="android:textColorHint">#999999</item>

        <!-- Button/controls -->
        <item name="colorButtonNormal">#E0E0E0</item>
        <item name="android:buttonStyle">@style/CustomButtonStyle</item>

        <!-- Tab/Toolbar -->
        <item name="tabIndicatorColor">#03DAC5</item>
        <item name="tabSelectedTextColor">#03DAC5</item>
        <item name="tabTextColor">#F0EDED</item>
        <item name="android:navigationBarColor">#03A9F4</item>
        <item name="android:statusBarColor">#F5F5F5</item>
    </style>

    <!-- Custom Button Styling -->
    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#000000</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
