<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DailerKotlin.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary background and surface -->
        <item name="colorPrimary">#121212</item> <!-- Deep dark -->
        <item name="colorPrimaryVariant">#1F1F1F</item> <!-- Slight contrast -->
        <item name="colorOnPrimary">#FFFFFF</item> <!-- Text on dark bg -->

        <!-- Accent and secondary -->
        <item name="colorAccent">#03DAC5</item>
        <item name="colorSecondary">#03DAC5</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>

        <!-- Text colors -->
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
        <item name="android:textColorHint">#888888</item>

        <!-- Buttons and controls -->
        <item name="colorButtonNormal">#2C2C2C</item>
        <item name="android:buttonStyle">@style/CustomButtonStyleDark</item>

        <!-- Tabs/toolbar -->
        <item name="tabIndicatorColor">#03DAC5</item>
        <item name="tabSelectedTextColor">#03DAC5</item>
        <item name="tabTextColor">#CCCCCC</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#1F1F1F</item>
    </style>

    <!-- Custom Button Styling for Dark -->
    <style name="CustomButtonStyleDark" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
